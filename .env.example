# Copy to .env (gitignored) to override. Expo inlines EXPO_PUBLIC_* at build time.
# Spark network: REGTEST (default when unset) or MAINNET.
EXPO_PUBLIC_SPARK_NETWORK=REGTEST
# Lightning address server (optional; leave both unset to disable). The domain is the part after the "@";
# the API URL is where /challenge and /users live. Both must be set together.
# EXPO_PUBLIC_LNADDRESS_DOMAIN=corisco.org
# EXPO_PUBLIC_LNADDRESS_API_URL=https://api.corisco.org
